// main.go (фрагмент)
r.POST("/chat", func(c *gin.Context) {
    var req struct {
        SessionID int         `json:"session_id"`
        Message   ChatMessage `json:"message"`
    }
    c.BindJSON(&req)

    // 1. Сохраняем входящее сообщение пользователя в базу
    saveMessage(db, Message{
        SessionID: req.SessionID,
        Role:      "user",
        Content:   req.Message.Content,
        MsgType:   req.Message.MsgType,
    })

    // 2. Логика Gemini (обработка текста или картинки)
    var prompt genai.Part
    if req.Message.MsgType == "image" {
        data, _ := base64.StdEncoding.DecodeString(req.Message.Content)
        prompt = genai.ImageData("jpeg", data)
    } else {
        prompt = genai.Text(req.Message.Content)
    }

    res, _ := model.GenerateContent(ctx, prompt)
    aiReply := extractText(res) // вспомогательная функция получения текста

    // 3. Сохраняем ответ ИИ в базу
    saveMessage(db, Message{
        SessionID: req.SessionID,
        Role:      "model",
        Content:   aiReply,
        MsgType:   "text",
    })

    c.JSON(200, gin.H{"reply": aiReply})
})
