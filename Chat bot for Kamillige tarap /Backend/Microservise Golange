package main

import (
	"context"
	"github.com/google/generative-ai-go/genai"
	"google.golang.org/api/option"
	"net/http"
	"github.com/gin-gonic/gin" // Популярный фреймворк для API
)

func main() {
	ctx := context.Background()
	client, _ := genai.NewClient(ctx, option.WithAPIKey("ВАШ_API_KEY"))
	defer client.Close()

	model := client.GenerativeModel("gemini-1.5-flash")

	r := gin.Default()
	r.POST("/chat", func(c *gin.Context) {
		var req struct {
			Message string `json:"message"`
		}
		if err := c.ShouldBindJSON(&req); err != nil {
			c.JSON(400, gin.H{"error": "Invalid request"})
			return
		}

		// Создаем сессию чата (здесь можно добавить историю)
		cs := model.StartChat()
		res, err := cs.SendMessage(ctx, genai.Text(req.Message))
		if err != nil {
			c.JSON(500, gin.H{"error": err.Error()})
			return
		}

		// Извлекаем текст ответа
		respText := ""
		if len(res.Candidates) > 0 {
			for _, part := range res.Candidates[0].Content.Parts {
				respText +=  part.(genai.Text)
			}
		}

		c.JSON(200, gin.H{"reply": respText})
	})

	r.Run(":8080")
}
