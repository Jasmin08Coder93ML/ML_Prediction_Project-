type ChatMessage struct {
	Role  string `json:"role"`  // "user" или "model"
	Parts string `json:"parts"` // текст сообщения
}

type ChatRequest struct {
	History []ChatMessage `json:"history"`
}

// Внутри обработчика (Handler):
func ChatHandler(c *gin.Context) {
    var req ChatRequest
    if err := c.ShouldBindJSON(&req); err != nil {
        c.JSON(400, gin.H{"error": "Bad request"})
        return
    }

    cs := model.StartChat()
    
    // Превращаем историю из JSON в формат, который понимает Gemini
    for _, msg := range req.History[:len(req.History)-1] {
        cs.History = append(cs.History, &genai.Content{
            Parts: []genai.Part{genai.Text(msg.Parts)},
            Role:  msg.Role,
        })
    }

    // Отправляем последнее сообщение
    lastMsg := req.History[len(req.History)-1].Parts
    res, err := cs.SendMessage(ctx, genai.Text(lastMsg))
    // ... получение ответа и отправка на фронтенд
}
