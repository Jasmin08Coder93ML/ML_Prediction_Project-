package main

import (
    "database/sql"
    "log"

    _ "github.com/mattn/go-sqlite3" // Драйвер для SQLite
)

// Структура сообщения для БД
type Message struct {
    SessionID int
    Role      string // "user" или "model"
    Content   string // Текст или Base64 картинки
    MsgType   string // "text" или "image"
}

// Функция сохранения сообщения
func saveMessage(db *sql.DB, msg Message) error {
    query := `
        INSERT INTO messages (session_id, role, content, msg_type)
        VALUES (?, ?, ?, ?)`
    
    _, err := db.Exec(query, msg.SessionID, msg.Role, msg.Content, msg.MsgType)
    if err != nil {
        log.Printf("Ошибка при сохранении сообщения: %v", err)
        return err
    }
    return nil
}
