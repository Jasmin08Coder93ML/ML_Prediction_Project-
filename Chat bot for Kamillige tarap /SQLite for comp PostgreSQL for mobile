-- Таблица пользователей (если её еще нет в основном приложении)
CREATE TABLE IF NOT EXISTS users (
    id SERIAL PRIMARY KEY,
    username VARCHAR(100)
);

-- Таблица чат-сессий (позволяет одному пользователю иметь несколько разных диалогов)
CREATE TABLE IF NOT EXISTS chat_sessions (
    id SERIAL PRIMARY KEY,
    user_id INTEGER REFERENCES users(id),
    title VARCHAR(255) DEFAULT 'Новый диалог',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Таблица самих сообщений
CREATE TABLE IF NOT EXISTS messages (
    id SERIAL PRIMARY KEY,
    session_id INTEGER REFERENCES chat_sessions(id) ON DELETE CASCADE,
    role VARCHAR(10) NOT NULL, -- 'user' или 'model'
    content TEXT NOT NULL,      -- Текст сообщения или Base64 картинки
    msg_type VARCHAR(10) DEFAULT 'text', -- 'text' или 'image'
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
