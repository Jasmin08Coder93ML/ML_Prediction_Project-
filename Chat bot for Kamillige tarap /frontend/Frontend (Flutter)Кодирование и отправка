// chat_service.dart
import 'dart:convert';
import 'dart:io';
import 'package:dio/dio.dart';

class ChatService {
  final Dio _dio = Dio(BaseOptions(baseUrl: "http://ваш_ip:8080"));

  Future<String> sendMessage({required String content, required String type, int sessionId = 1}) async {
    String payload = content;

    // Если это картинка, читаем файл и конвертируем в Base64
    if (type == "image") {
      File imageFile = File(content); // путь к файлу
      List<int> imageBytes = await imageFile.readAsBytes();
      payload = base64Encode(imageBytes);
    }

    final response = await _dio.post('/chat', data: {
      "session_id": sessionId,
      "message": {
        "role": "user",
        "content": payload,
        "msg_type": type
      }
    });

    return response.data['reply'];
  }
}
